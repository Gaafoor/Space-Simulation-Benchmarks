For i = 1:1:1008;
   Propagate Prop_C2(B1_SC_C2) {B1_SC_C2.ElapsedSecs = stepSec};
   Report R2 B1_SC_C2.ElapsedSecs B1_SC_C2.EarthMJ2000Eq.X B1_SC_C2.EarthMJ2000Eq.Y B1_SC_C2.EarthMJ2000Eq.Z B1_SC_C2.EarthMJ2000Eq.VX B1_SC_C2.EarthMJ2000Eq.VY B1_SC_C2.EarthMJ2000Eq.VZ;
EndFor;

Report R3 B1_SC_C3.ElapsedSecs B1_SC_C3.EarthMJ2000Eq.X B1_SC_C3.EarthMJ2000Eq.Y B1_SC_C3.EarthMJ2000Eq.Z B1_SC_C3.EarthMJ2000Eq.VX B1_SC_C3.EarthMJ2000Eq.VY B1_SC_C3.EarthMJ2000Eq.VZ;

For i = 1:1:1008;
   Propagate Prop_C3(B1_SC_C3) {B1_SC_C3.ElapsedSecs = stepSec};
   Report R3 B1_SC_C3.ElapsedSecs B1_SC_C3.EarthMJ2000Eq.X B1_SC_C3.EarthMJ2000Eq.Y B1_SC_C3.EarthMJ2000Eq.Z B1_SC_C3.EarthMJ2000Eq.VX B1_SC_C3.EarthMJ2000Eq.VY B1_SC_C3.EarthMJ2000Eq.VZ;
EndFor;

Report R4 B1_SC_C4.ElapsedSecs B1_SC_C4.EarthMJ2000Eq.X B1_SC_C4.EarthMJ2000Eq.Y B1_SC_C4.EarthMJ2000Eq.Z B1_SC_C4.EarthMJ2000Eq.VX B1_SC_C4.EarthMJ2000Eq.VY B1_SC_C4.EarthMJ2000Eq.VZ;

For i = 1:1:1008;
   Propagate Prop_C4(B1_SC_C4) {B1_SC_C4.ElapsedSecs = stepSec};
   Report R4 B1_SC_C4.ElapsedSecs B1_SC_C4.EarthMJ2000Eq.X B1_SC_C4.EarthMJ2000Eq.Y B1_SC_C4.EarthMJ2000Eq.Z B1_SC_C4.EarthMJ2000Eq.VX B1_SC_C4.EarthMJ2000Eq.VY B1_SC_C4.EarthMJ2000Eq.VZ;
EndFor;

Report R5 B1_SC_C5.ElapsedSecs B1_SC_C5.EarthMJ2000Eq.X B1_SC_C5.EarthMJ2000Eq.Y B1_SC_C5.EarthMJ2000Eq.Z B1_SC_C5.EarthMJ2000Eq.VX B1_SC_C5.EarthMJ2000Eq.VY B1_SC_C5.EarthMJ2000Eq.VZ;

For i = 1:1:1008;
