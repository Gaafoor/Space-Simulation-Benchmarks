%----------------------------------------

Create ReportFile R1;
R1.SolverIterations = Current;
R1.UpperLeft = [ 0 0 ];
R1.Size = [ 0 0 ];
R1.RelativeZOrder = 0;
R1.Maximized = false;

R1.Filename = 'gmat_b1_case1_twobody_state.csv';

R1.Precision = 16;

R1.WriteHeaders = true;
R1.LeftJustify = On;
R1.ZeroFill = Off;
R1.FixedWidth = true;
R1.Delimiter = ' ';
R1.ColumnWidth = 23;
R1.WriteReport = true;
R1.AppendToExistingFile = false;

