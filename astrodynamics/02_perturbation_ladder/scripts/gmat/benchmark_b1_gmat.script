%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------

%----------------------------------------
% Variables
%----------------------------------------

Create Variable i stepSec;
i = 0;
stepSec = 600;


%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView B1_OrbitView_View;

B1_OrbitView_View.ViewFrame = CoordinateSystem;
B1_OrbitView_View.ViewTrajectory = Off;
B1_OrbitView_View.InertialFrame = Off;

B1_OrbitView_View.SetDefaultLocation = On;
B1_OrbitView_View.DefaultEye = [ 30000 0 0 ];
B1_OrbitView_View.DefaultCenter = [ 0 0 0 ];
B1_OrbitView_View.DefaultUp = [ 0 0 1 ];

B1_OrbitView_View.SetCurrentLocation = On;
B1_OrbitView_View.CurrentEye = [ 21589.93694279414 5559.096130248384 5629.885687735225 ];
B1_OrbitView_View.CurrentCenter = [ 0 0 1.818989403545856e-12 ];
B1_OrbitView_View.CurrentUp = [ -0.232602403125254 -0.07839088332909117 0.9694075466341501 ];
B1_OrbitView_View.FOVy = 45;

%----------------------------------------
% Mission Sequence
%----------------------------------------

BeginMissionSequence;

Report R1 B1_SC_C1.ElapsedSecs B1_SC_C1.EarthMJ2000Eq.X B1_SC_C1.EarthMJ2000Eq.Y B1_SC_C1.EarthMJ2000Eq.Z B1_SC_C1.EarthMJ2000Eq.VX B1_SC_C1.EarthMJ2000Eq.VY B1_SC_C1.EarthMJ2000Eq.VZ;

For i = 1:1:1008;
   Propagate Prop_C1(B1_SC_C1) {B1_SC_C1.ElapsedSecs = stepSec};
   Report R1 B1_SC_C1.ElapsedSecs B1_SC_C1.EarthMJ2000Eq.X B1_SC_C1.EarthMJ2000Eq.Y B1_SC_C1.EarthMJ2000Eq.Z B1_SC_C1.EarthMJ2000Eq.VX B1_SC_C1.EarthMJ2000Eq.VY B1_SC_C1.EarthMJ2000Eq.VZ;
EndFor;

