B1_GroundTrack.Add = {B1_SC_C1, B1_SC_C2, B1_SC_C3, B1_SC_C4, B1_SC_C5};

B1_GroundTrack.DataCollectFrequency = 1;
B1_GroundTrack.UpdatePlotFrequency = 50;
B1_GroundTrack.NumPointsToRedraw = 0;
B1_GroundTrack.MaxPlotPoints = 20000;
B1_GroundTrack.ShowPlot = true;

%----------------------------------------
