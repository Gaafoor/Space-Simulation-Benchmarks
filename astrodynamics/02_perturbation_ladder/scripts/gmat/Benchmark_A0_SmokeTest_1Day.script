% Sequential 1-day smoke
% CATEC Benchmark A-0 — GMAT (syntax aligned with benchmark_b1_gmat.script)
% Spec: catec_ws/benchmarks/benchmark_a/config/A0_PHYSICS_FIDELITY_1Y.md
%
% GMAT R2026a patterns from Intern_ws/benchmarks/benchmark_b/gmat/benchmark_b1_gmat.script

Earth.EquatorialRadius = 6378.1366;
Earth.Flattening = 0.00335281310845547;
% --- Case 1 ---
Create Spacecraft A0_C1;
A0_C1.DateFormat = UTCGregorian;
A0_C1.Epoch = '02 Jun 2026 00:00:00.000';
A0_C1.CoordinateSystem = EarthMJ2000Eq;
A0_C1.DisplayStateType = Keplerian;
A0_C1.SMA = 6878.137;
A0_C1.ECC = 0;
A0_C1.INC = 97.4;
A0_C1.RAAN = 0;
A0_C1.AOP = 0;
A0_C1.TA = 0;
A0_C1.DryMass = 12;
A0_C1.Cd = 2.2;
A0_C1.Cr = 1.8;
A0_C1.DragArea = 0.08;
A0_C1.SRPArea = 0.10;
A0_C1.OrbitColor = Red;

        Create ForceModel FM_C1;
        FM_C1.CentralBody = Earth;
FM_C1.PrimaryBodies = {Earth};
FM_C1.RelativisticCorrection = Off;
FM_C1.ErrorControl = RSSStep;
FM_C1.GravityField.Earth.Degree = 0;
FM_C1.GravityField.Earth.Order = 0;
FM_C1.GravityField.Earth.StmLimit = 100;
FM_C1.GravityField.Earth.PotentialFile = 'JGM2.cof';
FM_C1.GravityField.Earth.TideModel = 'None';

        FM_C1.Drag = None;
        FM_C1.SRP = Off;

Create Propagator Prop_C1;
Prop_C1.FM = FM_C1;
Prop_C1.Type = RungeKutta89;
Prop_C1.InitialStepSize = 10;
Prop_C1.Accuracy = 1e-12;
Prop_C1.MinStep = 0.001;
Prop_C1.MaxStep = 60;
Prop_C1.MaxStepAttempts = 50;
Prop_C1.StopIfAccuracyIsViolated = true;

Create ReportFile R1;
R1.SolverIterations = Current;
R1.Filename = '../../../data/benchmark_a/gmat/a0_physics_fidelity/a0_case1_twobody/gmat_state.csv';
R1.Precision = 16;
R1.WriteHeaders = true;
R1.LeftJustify = On;
R1.ZeroFill = Off;
R1.FixedWidth = true;
R1.Delimiter = ' ';
R1.ColumnWidth = 23;
R1.WriteReport = true;
R1.AppendToExistingFile = false;

% --- Case 2 ---
Create Spacecraft A0_C2;
A0_C2.DateFormat = UTCGregorian;
A0_C2.Epoch = '02 Jun 2026 00:00:00.000';
A0_C2.CoordinateSystem = EarthMJ2000Eq;
A0_C2.DisplayStateType = Keplerian;
A0_C2.SMA = 6878.137;
