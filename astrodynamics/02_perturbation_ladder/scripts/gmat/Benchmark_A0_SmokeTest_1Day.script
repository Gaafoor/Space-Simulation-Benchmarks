% --- Case 5 ---
Create Spacecraft A0_C5;
A0_C5.DateFormat = UTCGregorian;
A0_C5.Epoch = '02 Jun 2026 00:00:00.000';
A0_C5.CoordinateSystem = EarthMJ2000Eq;
A0_C5.DisplayStateType = Keplerian;
A0_C5.SMA = 6878.137;
A0_C5.ECC = 0;
A0_C5.INC = 97.4;
A0_C5.RAAN = 0;
A0_C5.AOP = 0;
A0_C5.TA = 0;
A0_C5.DryMass = 12;
A0_C5.Cd = 2.2;
A0_C5.Cr = 1.8;
A0_C5.DragArea = 0.08;
A0_C5.SRPArea = 0.10;
A0_C5.OrbitColor = Yellow;

Create ForceModel FM_C5;
FM_C5.CentralBody = Earth;
FM_C5.PrimaryBodies = {Earth};
FM_C5.RelativisticCorrection = Off;
FM_C5.ErrorControl = RSSStep;
FM_C5.GravityField.Earth.Degree = 20;
FM_C5.GravityField.Earth.Order = 20;
FM_C5.GravityField.Earth.StmLimit = 100;
FM_C5.GravityField.Earth.PotentialFile = 'JGM2.cof';
FM_C5.GravityField.Earth.TideModel = 'None';

FM_C5.PointMasses = {Sun, Luna};
FM_C5.Drag.AtmosphereModel = NRLMSISE00;
FM_C5.Drag.HistoricWeatherSource = 'CSSISpaceWeatherFile';
FM_C5.Drag.PredictedWeatherSource = 'CSSISpaceWeatherFile';
FM_C5.Drag.CSSISpaceWeatherFile = 'SpaceWeather-All-v1.2.txt';
FM_C5.Drag.SchattenFile = 'SchattenPredict.txt';
FM_C5.Drag.F107 = 150;
FM_C5.Drag.F107A = 150;
FM_C5.Drag.MagneticIndex = 3;
FM_C5.Drag.SchattenErrorModel = 'Nominal';
FM_C5.Drag.SchattenTimingModel = 'NominalCycle';
FM_C5.Drag.DragModel = 'Spherical';

FM_C5.SRP = On;
FM_C5.SRP.Flux = 1367;
FM_C5.SRP.SRPModel = Spherical;
FM_C5.SRP.Nominal_Sun = 149597870.691;

Create Propagator Prop_C5;
Prop_C5.FM = FM_C5;
Prop_C5.Type = RungeKutta89;
Prop_C5.InitialStepSize = 10;
Prop_C5.Accuracy = 1e-12;
Prop_C5.MinStep = 0.001;
Prop_C5.MaxStep = 60;
Prop_C5.MaxStepAttempts = 50;
Prop_C5.StopIfAccuracyIsViolated = true;

Create ReportFile R5;
R5.SolverIterations = Current;
R5.Filename = '../../../data/benchmark_a/gmat/a0_physics_fidelity/a0_case5_all_supported/gmat_state.csv';
R5.Precision = 16;
R5.WriteHeaders = true;
R5.LeftJustify = On;
R5.ZeroFill = Off;
R5.FixedWidth = true;
R5.Delimiter = ' ';
R5.ColumnWidth = 23;
R5.WriteReport = true;
R5.AppendToExistingFile = false;
Create Variable i stepSec;
i = 0;
stepSec = 60;

BeginMissionSequence;

Report R1 A0_C1.ElapsedSecs A0_C1.EarthMJ2000Eq.X A0_C1.EarthMJ2000Eq.Y A0_C1.EarthMJ2000Eq.Z A0_C1.EarthMJ2000Eq.VX A0_C1.EarthMJ2000Eq.VY A0_C1.EarthMJ2000Eq.VZ;
For i = 1:1:1440;
   Propagate Prop_C1(A0_C1) {A0_C1.ElapsedSecs = stepSec};
   Report R1 A0_C1.ElapsedSecs A0_C1.EarthMJ2000Eq.X A0_C1.EarthMJ2000Eq.Y A0_C1.EarthMJ2000Eq.Z A0_C1.EarthMJ2000Eq.VX A0_C1.EarthMJ2000Eq.VY A0_C1.EarthMJ2000Eq.VZ;
EndFor;

Report R2 A0_C2.ElapsedSecs A0_C2.EarthMJ2000Eq.X A0_C2.EarthMJ2000Eq.Y A0_C2.EarthMJ2000Eq.Z A0_C2.EarthMJ2000Eq.VX A0_C2.EarthMJ2000Eq.VY A0_C2.EarthMJ2000Eq.VZ;
For i = 1:1:1440;
   Propagate Prop_C2(A0_C2) {A0_C2.ElapsedSecs = stepSec};
   Report R2 A0_C2.ElapsedSecs A0_C2.EarthMJ2000Eq.X A0_C2.EarthMJ2000Eq.Y A0_C2.EarthMJ2000Eq.Z A0_C2.EarthMJ2000Eq.VX A0_C2.EarthMJ2000Eq.VY A0_C2.EarthMJ2000Eq.VZ;
EndFor;

Report R3 A0_C3.ElapsedSecs A0_C3.EarthMJ2000Eq.X A0_C3.EarthMJ2000Eq.Y A0_C3.EarthMJ2000Eq.Z A0_C3.EarthMJ2000Eq.VX A0_C3.EarthMJ2000Eq.VY A0_C3.EarthMJ2000Eq.VZ;
For i = 1:1:1440;
   Propagate Prop_C3(A0_C3) {A0_C3.ElapsedSecs = stepSec};
   Report R3 A0_C3.ElapsedSecs A0_C3.EarthMJ2000Eq.X A0_C3.EarthMJ2000Eq.Y A0_C3.EarthMJ2000Eq.Z A0_C3.EarthMJ2000Eq.VX A0_C3.EarthMJ2000Eq.VY A0_C3.EarthMJ2000Eq.VZ;
EndFor;

Report R4 A0_C4.ElapsedSecs A0_C4.EarthMJ2000Eq.X A0_C4.EarthMJ2000Eq.Y A0_C4.EarthMJ2000Eq.Z A0_C4.EarthMJ2000Eq.VX A0_C4.EarthMJ2000Eq.VY A0_C4.EarthMJ2000Eq.VZ;
For i = 1:1:1440;
   Propagate Prop_C4(A0_C4) {A0_C4.ElapsedSecs = stepSec};
   Report R4 A0_C4.ElapsedSecs A0_C4.EarthMJ2000Eq.X A0_C4.EarthMJ2000Eq.Y A0_C4.EarthMJ2000Eq.Z A0_C4.EarthMJ2000Eq.VX A0_C4.EarthMJ2000Eq.VY A0_C4.EarthMJ2000Eq.VZ;
EndFor;

Report R5 A0_C5.ElapsedSecs A0_C5.EarthMJ2000Eq.X A0_C5.EarthMJ2000Eq.Y A0_C5.EarthMJ2000Eq.Z A0_C5.EarthMJ2000Eq.VX A0_C5.EarthMJ2000Eq.VY A0_C5.EarthMJ2000Eq.VZ;
For i = 1:1:1440;
   Propagate Prop_C5(A0_C5) {A0_C5.ElapsedSecs = stepSec};
   Report R5 A0_C5.ElapsedSecs A0_C5.EarthMJ2000Eq.X A0_C5.EarthMJ2000Eq.Y A0_C5.EarthMJ2000Eq.Z A0_C5.EarthMJ2000Eq.VX A0_C5.EarthMJ2000Eq.VY A0_C5.EarthMJ2000Eq.VZ;
EndFor;
