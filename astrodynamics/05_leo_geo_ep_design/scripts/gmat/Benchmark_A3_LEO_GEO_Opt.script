Earth.EquatorialRadius = 6378.1366;
Earth.Flattening = 0.00335281310845547;

Create Spacecraft A3_SC;
A3_SC.DateFormat = UTCGregorian;
A3_SC.Epoch = '15 Jun 2026 12:00:00.000';
A3_SC.CoordinateSystem = EarthMJ2000Eq;
A3_SC.DisplayStateType = Keplerian;
A3_SC.SMA = 6878.137000000008;
A3_SC.ECC = 8.582647785749977e-16;
A3_SC.INC = 28.5;
A3_SC.RAAN = 0;
A3_SC.AOP = 0;
A3_SC.TA = 0;
A3_SC.DryMass = 12;
A3_SC.Cd = 2.2;
A3_SC.Cr = 1.8;
A3_SC.DragArea = 0.08;
A3_SC.SRPArea = 0.1;
A3_SC.Tanks = {A3_Tank};
A3_SC.Thrusters = {A3_Engine};
A3_SC.PowerSystem = SolarPowerSystem1;
A3_SC.NAIFId = -10008001;
A3_SC.NAIFIdReferenceFrame = -9008001;
A3_SC.OrbitColor = Yellow;
A3_SC.TargetColor = Teal;
A3_SC.Id = 'SatId';
A3_SC.Attitude = CoordinateSystemFixed;
A3_SC.AttitudeCoordinateSystem = EarthMJ2000Eq;
A3_SC.EulerAngleSequence = '321';

Create ElectricTank A3_Tank;
A3_Tank.DirectionX = 0;
A3_Tank.DirectionY = 0;
A3_Tank.DirectionZ = 1;
A3_Tank.SecondDirectionX = 0;
A3_Tank.SecondDirectionY = -1;
A3_Tank.SecondDirectionZ = 0;
A3_Tank.AllowNegativeFuelMass = true;
A3_Tank.FuelMass = 5;

Create ElectricThruster A3_Engine;
A3_Engine.CoordinateSystem = Local;
A3_Engine.Origin = Earth;
A3_Engine.Axes = VNB;
A3_Engine.ThrustDirection1 = 1;
A3_Engine.ThrustDirection2 = 0;
A3_Engine.ThrustDirection3 = 0;
A3_Engine.DutyCycle = 1;
A3_Engine.ThrustScaleFactor = 1;
A3_Engine.DecrementMass = true;
A3_Engine.Tank = {A3_Tank};
A3_Engine.MixRatio = [ 1 ];
A3_Engine.GravitationalAccel = 9.81;
A3_Engine.ThrustModel = ThrustMassPolynomial;
A3_Engine.MaximumUsablePower = 7.266;
A3_Engine.MinimumUsablePower = 0.638;
A3_Engine.ThrustCoeff1 = -5.19082;
A3_Engine.ThrustCoeff2 = 2.96519;
A3_Engine.ThrustCoeff3 = -14.4789;
A3_Engine.ThrustCoeff4 = 54.05382;
A3_Engine.ThrustCoeff5 = -0.00100092;
A3_Engine.MassFlowCoeff1 = -0.004776;
A3_Engine.MassFlowCoeff2 = 0.05717;
A3_Engine.MassFlowCoeff3 = -0.09956;
A3_Engine.MassFlowCoeff4 = 0.03211;
A3_Engine.MassFlowCoeff5 = 2.13781;
A3_Engine.FixedEfficiency = 0.7;
A3_Engine.Isp = 2500;
A3_Engine.ConstantThrust = 0.05;

Create SolarPowerSystem SolarPowerSystem1;
SolarPowerSystem1.EpochFormat = 'UTCGregorian';
SolarPowerSystem1.InitialEpoch = '15 Jun 2026 12:00:00.000';
SolarPowerSystem1.InitialMaxPower = 1.2;
SolarPowerSystem1.AnnualDecayRate = 5;
SolarPowerSystem1.Margin = 5;
SolarPowerSystem1.BusCoeff1 = 0.3;
SolarPowerSystem1.ShadowModel = 'DualCone';
SolarPowerSystem1.ShadowBodies = {'Earth'};
SolarPowerSystem1.SolarCoeff1 = 1.32077;
SolarPowerSystem1.SolarCoeff2 = -0.10848;
SolarPowerSystem1.SolarCoeff3 = -0.11665;
SolarPowerSystem1.SolarCoeff4 = 0.10843;
SolarPowerSystem1.SolarCoeff5 = -0.01279;

Create GroundStation Madrid;
Madrid.CentralBody = Earth;
Madrid.StateType = Spherical;
Madrid.HorizonReference = Ellipsoid;
Madrid.Location1 = 40.4168;
Madrid.Location2 = 356.2962;
Madrid.Location3 = 0.667;
Madrid.Id = 'StationId';
Madrid.MinimumElevationAngle = 10;

Create ForceModel A3_FM;
A3_FM.CentralBody = Earth;
A3_FM.PrimaryBodies = {Earth};
A3_FM.PointMasses = {Sun, Luna};
A3_FM.SRP = On;
A3_FM.RelativisticCorrection = Off;
A3_FM.ErrorControl = RSSStep;
A3_FM.GravityField.Earth.Degree = 20;
A3_FM.GravityField.Earth.Order = 20;
A3_FM.GravityField.Earth.PotentialFile = 'JGM2.cof';
A3_FM.SRP.Flux = 1367;
A3_FM.SRP.SRPModel = Spherical;
A3_FM.SRP.Nominal_Sun = 149597870.691;
A3_FM.Drag.AtmosphereModel = NRLMSISE00;
A3_FM.Drag.HistoricWeatherSource = 'CSSISpaceWeatherFile';
A3_FM.Drag.PredictedWeatherSource = 'CSSISpaceWeatherFile';
A3_FM.Drag.CSSISpaceWeatherFile = 'SpaceWeather-All-v1.2.txt';
A3_FM.Drag.SchattenFile = 'SchattenPredict.txt';
A3_FM.Drag.F107 = 150;
A3_FM.Drag.F107A = 150;
A3_FM.Drag.MagneticIndex = 3;

Create Propagator A3_Prop;
A3_Prop.FM = A3_FM;
A3_Prop.Type = RungeKutta89;
A3_Prop.InitialStepSize = 10;
A3_Prop.Accuracy = 1e-8;      % Changed from 1e-10 to 1e-8
A3_Prop.MinStep = 0.0001;     % Changed from 0.001 to allow micro-steps safely
A3_Prop.MaxStep = 1800;       % Reduced max step from 2700 to 1800 for stability
A3_Prop.MaxStepAttempts = 100; % Increased attempts before throwing an exception
A3_Prop.StopIfAccuracyIsViolated = false; % <--- CRITICAL: Prevents hard crashes

Create FiniteBurn A3_FB;
A3_FB.Thrusters = {A3_Engine};
A3_FB.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create ContactLocator A3_Contacts;
A3_Contacts.Target = A3_SC;
A3_Contacts.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/madrid_contacts.txt';
A3_Contacts.InputEpochFormat = 'UTCGregorian';
A3_Contacts.InitialEpoch = '15 Jun 2026 12:00:00.000';
A3_Contacts.StepSize = 60;
A3_Contacts.FinalEpoch = '20 Jun 2026 12:00:00.000';
A3_Contacts.UseLightTimeDelay = true;
A3_Contacts.UseStellarAberration = true;
A3_Contacts.WriteReport = true;
A3_Contacts.RunMode = Automatic;
A3_Contacts.UseEntireInterval = true;
A3_Contacts.Observers = {Madrid};
A3_Contacts.LightTimeDirection = Transmit;

Create VF13ad A3_Opt;
A3_Opt.ShowProgress = true;
A3_Opt.ReportStyle = Normal;
A3_Opt.ReportFile = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/vf13ad_opt.data';
A3_Opt.MaximumIterations = 250;
A3_Opt.Tolerance = 1e-5;
A3_Opt.UseCentralDifferences = false;
A3_Opt.UseFeasibility = true;
A3_Opt.FeasibilityTolerance = 1e-4;
A3_Opt.MaximumLineSearches = 20;
A3_Opt.CheckPhysicalTolerances = true;

Create ReportFile A3_StateHist;
A3_StateHist.SolverIterations = Current;
A3_StateHist.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/gmat_state.csv';
A3_StateHist.Precision = 16;
A3_StateHist.WriteHeaders = true;
A3_StateHist.FixedWidth = true;
A3_StateHist.Delimiter = ' ';
A3_StateHist.ColumnWidth = 23;
A3_StateHist.WriteReport = true;

Create ReportFile A3_SpiralEvents;
A3_SpiralEvents.SolverIterations = Current;
A3_SpiralEvents.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/spiral_events.txt';
A3_SpiralEvents.Precision = 16;
A3_SpiralEvents.WriteHeaders = true;
A3_SpiralEvents.FixedWidth = true;
A3_SpiralEvents.Delimiter = ' ';
A3_SpiralEvents.ColumnWidth = 23;
A3_SpiralEvents.WriteReport = true;

Create ReportFile A3_FinalReport;
A3_FinalReport.SolverIterations = Current;
A3_FinalReport.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/gmat_final.txt';
A3_FinalReport.Precision = 16;
A3_FinalReport.WriteHeaders = true;
A3_FinalReport.FixedWidth = true;
A3_FinalReport.Delimiter = ' ';
A3_FinalReport.ColumnWidth = 23;
A3_FinalReport.WriteReport = true;

Create EphemerisFile A3_Ephem;
A3_Ephem.Spacecraft = A3_SC;
A3_Ephem.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/a3_reference.bsp';
A3_Ephem.FileFormat = SPK;
A3_Ephem.EpochFormat = UTCGregorian;
A3_Ephem.InitialEpoch = 15 Jun 2026 12:00:00.000;
A3_Ephem.FinalEpoch = FinalSpacecraftEpoch;
A3_Ephem.StepSize = IntegratorSteps;
A3_Ephem.Interpolator = Hermite;
A3_Ephem.InterpolationOrder = 7;
A3_Ephem.CoordinateSystem = EarthMJ2000Eq;
A3_Ephem.OutputFormat = LittleEndian;
A3_Ephem.WriteEphemeris = true;

Create Variable i stepSec geoSmaKm geoEcc geoIncTargetDeg eventCode;
Create Variable segDur1 segDur2 segDur3 segDur4 accumTime;

geoSmaKm = 42164;
geoEcc = 0.01;
geoIncTargetDeg = 5.0;
i = 0;
stepSec = 60;
eventCode = 0;

segDur1 = 12;
segDur2 = 12;
segDur3 = 10;
segDur4 = 8;

BeginMissionSequence;

Report A3_StateHist A3_SC.ElapsedSecs A3_SC.EarthMJ2000Eq.X A3_SC.EarthMJ2000Eq.Y A3_SC.EarthMJ2000Eq.Z A3_SC.EarthMJ2000Eq.VX A3_SC.EarthMJ2000Eq.VY A3_SC.EarthMJ2000Eq.VZ;
eventCode = 1;
Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

Propagate 'Prop To Perigee' A3_Prop(A3_SC) {A3_SC.Earth.Periapsis};

Optimize 'A3_SpiralAndTrim_NLP' A3_Opt {SolveMode = Solve, ExitMode = SaveAndContinue, ShowProgressWindow = true};

   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection1 = 1, {Perturbation = 1e-4, Lower = 0.2, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection2 = 0.1, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection3 = 0, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(segDur1 = 12, {Perturbation = 1e-3, Lower = 1, Upper = 25, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   
   accumTime = A3_SC.ElapsedDays + segDur1;
   BeginFiniteBurn A3_FB(A3_SC);
   Propagate 'Seg1_EnergyRaise' A3_Prop(A3_SC) {A3_SC.ElapsedDays = accumTime};
   EndFiniteBurn A3_FB(A3_SC);
   
   eventCode = 21;
   Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection1 = 0.95, {Perturbation = 1e-4, Lower = 0.2, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection2 = -0.1, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection3 = -0.1, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(segDur2 = 12, {Perturbation = 1e-3, Lower = 1, Upper = 25, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   
   accumTime = A3_SC.ElapsedDays + segDur2;
   BeginFiniteBurn A3_FB(A3_SC);
   Propagate 'Seg2_RaiseAndBias' A3_Prop(A3_SC) {A3_SC.ElapsedDays = accumTime};
   EndFiniteBurn A3_FB(A3_SC);
   
   eventCode = 22;
   Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection1 = 0.7, {Perturbation = 1e-4, Lower = 0.1, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection2 = 0.1, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection3 = -0.5, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(segDur3 = 10, {Perturbation = 1e-3, Lower = 1, Upper = 25, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   
   accumTime = A3_SC.ElapsedDays + segDur3;
   BeginFiniteBurn A3_FB(A3_SC);
   Propagate 'Seg3_IncTrim' A3_Prop(A3_SC) {A3_SC.ElapsedDays = accumTime};
   EndFiniteBurn A3_FB(A3_SC);
   
   eventCode = 23;
   Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection1 = 0.85, {Perturbation = 1e-4, Lower = 0.1, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection2 = -0.1, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(A3_SC.A3_Engine.ThrustDirection3 = -0.2, {Perturbation = 1e-4, Lower = -1.0, Upper = 1.0, MaxStep = 0.05, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_Opt(segDur4 = 8, {Perturbation = 1e-3, Lower = 1, Upper = 25, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   
   accumTime = A3_SC.ElapsedDays + segDur4;
   BeginFiniteBurn A3_FB(A3_SC);
   Propagate 'Seg4_ToGEO' A3_Prop(A3_SC) {A3_SC.ElapsedDays = accumTime};
   EndFiniteBurn A3_FB(A3_SC);
   
   eventCode = 24;
   Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

   Minimize A3_Opt(A3_SC.ElapsedDays);

   NonlinearConstraint A3_Opt(A3_SC.Earth.SMA >= 42100);
   NonlinearConstraint A3_Opt(A3_SC.Earth.SMA <= 42200);
   NonlinearConstraint A3_Opt(A3_SC.Earth.ECC <= geoEcc);
   NonlinearConstraint A3_Opt(A3_SC.EarthMJ2000Eq.INC <= geoIncTargetDeg);

EndOptimize;

eventCode = 13;
Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

For i = 1:1:720;
   Propagate 'Post GEO Coast' A3_Prop(A3_SC) {A3_SC.ElapsedSecs = 60};
   Report A3_StateHist A3_SC.ElapsedSecs A3_SC.EarthMJ2000Eq.X A3_SC.EarthMJ2000Eq.Y A3_SC.EarthMJ2000Eq.Z A3_SC.EarthMJ2000Eq.VX A3_SC.EarthMJ2000Eq.VY A3_SC.EarthMJ2000Eq.VZ;
EndFor;

Report A3_FinalReport A3_SC.ElapsedSecs A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC A3_SC.TotalMass;