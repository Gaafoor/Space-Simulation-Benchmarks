A3_FinalReport.FixedWidth = true;
A3_FinalReport.Delimiter = ' ';
A3_FinalReport.ColumnWidth = 23;
A3_FinalReport.WriteReport = true;
A3_FinalReport.AppendToExistingFile = false;

Create ReportFile A3_SpiralEvents;
A3_SpiralEvents.SolverIterations = Current;
A3_SpiralEvents.UpperLeft = [ 0.1 0.2 ];
A3_SpiralEvents.Size = [ 0.55 0.4 ];
A3_SpiralEvents.RelativeZOrder = 1554;
A3_SpiralEvents.Maximized = false;
A3_SpiralEvents.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/spiral_events.txt';
A3_SpiralEvents.Precision = 16;
A3_SpiralEvents.WriteHeaders = true;
A3_SpiralEvents.LeftJustify = On;
A3_SpiralEvents.ZeroFill = Off;
A3_SpiralEvents.FixedWidth = true;
A3_SpiralEvents.Delimiter = ' ';
A3_SpiralEvents.ColumnWidth = 23;
A3_SpiralEvents.WriteReport = true;
A3_SpiralEvents.AppendToExistingFile = false;

Create EphemerisFile A3_Ephem;
A3_Ephem.UpperLeft = [ 0 0 ];
A3_Ephem.Size = [ 0 0 ];
A3_Ephem.RelativeZOrder = 0;
A3_Ephem.Maximized = false;
A3_Ephem.Spacecraft = A3_SC;
A3_Ephem.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/a3_reference.bsp';
A3_Ephem.FileFormat = SPK;
A3_Ephem.EpochFormat = UTCGregorian;
A3_Ephem.InitialEpoch = 15 Jun 2026 12:00:00.000;
A3_Ephem.FinalEpoch = FinalSpacecraftEpoch;
A3_Ephem.StepSize = IntegratorSteps;
A3_Ephem.Interpolator = Hermite;
A3_Ephem.InterpolationOrder = 7;
A3_Ephem.CoordinateSystem = EarthMJ2000Eq;
A3_Ephem.OutputFormat = LittleEndian;
A3_Ephem.IncludeCovariance = None;
A3_Ephem.WriteEphemeris = true;

Create OpenFramesInterface OrbitView1;
OrbitView1.SolverIterations = Current;
OrbitView1.UpperLeft = [ 0 0 ];
OrbitView1.Size = [ 0.3905882352941176 0.5102286401925391 ];
OrbitView1.RelativeZOrder = 239;
OrbitView1.Maximized = false;
OrbitView1.Add = {A3_SC, Earth};
OrbitView1.View = {OrbitView1_View};
OrbitView1.CoordinateSystem = EarthMJ2000Eq;
OrbitView1.DrawObject = [ true true ];
OrbitView1.DrawTrajectory = [ true true ];
OrbitView1.DrawAxes = [ false false ];
OrbitView1.DrawXYPlane = [ false false ];
OrbitView1.DrawLabel = [ true true ];
OrbitView1.DrawUsePropLabel = [ false false ];
OrbitView1.DrawCenterPoint = [ true true ];
OrbitView1.DrawEndPoints = [ true true ];
OrbitView1.DrawVelocity = [ false false ];
OrbitView1.DrawGrid = [ false false ];
OrbitView1.DrawLineWidth = [ 2 2 ];
OrbitView1.DrawMarkerSize = [ 10 10 ];
OrbitView1.DrawFontSize = [ 20 20 ];
OrbitView1.Axes = On;
OrbitView1.AxesLength = 12756.2726;
OrbitView1.AxesLabels = On;
OrbitView1.FrameLabel = Off;
OrbitView1.XYPlane = On;
OrbitView1.EclipticPlane = On;
OrbitView1.EnableStars = On;
OrbitView1.StarCatalog = 'inp_StarsHYGv3.txt';
OrbitView1.StarCount = 40000;
OrbitView1.MinStarMag = -2;
OrbitView1.MaxStarMag = 6;
OrbitView1.MinStarPixels = 1;
OrbitView1.MaxStarPixels = 10;
OrbitView1.MinStarDimRatio = 0.5;
OrbitView1.ShowPlot = true;
OrbitView1.ShowToolbar = true;
OrbitView1.SolverIterLastN = 1;
OrbitView1.ShowVR = false;
OrbitView1.PlaybackTimeScale = 3600;
OrbitView1.MultisampleAntiAliasing = On;
OrbitView1.MSAASamples = 2;
OrbitView1.DrawFontPosition = {'Top-Right', 'Top-Right'};

%----------------------------------------
%---------- Arrays, Variables, Strings
%----------------------------------------
Create Variable burn1Duration burn2Duration i stepSec geoSmaKm geoEcc geoEccPhaseA geoIncDeg burn2_5Duration eventCode;
burn1Duration = 300;
burn2Duration = 300;
i = 0;
stepSec = 60;
geoSmaKm = 42164;
geoEcc = 0.001;
geoEccPhaseA = 0.055;
geoIncDeg = 0;
burn2_5Duration = 5;
eventCode = 0;








%----------------------------------------
%---------- User Objects
%----------------------------------------

Create OpenFramesView OrbitView1_View;
OrbitView1_View.ViewFrame = CoordinateSystem;
OrbitView1_View.ViewTrajectory = Off;
OrbitView1_View.InertialFrame = Off;
OrbitView1_View.SetDefaultLocation = On;
OrbitView1_View.DefaultEye = [ 30000 0 0 ];
OrbitView1_View.DefaultCenter = [ 0 0 0 ];
OrbitView1_View.DefaultUp = [ 0 0 1 ];
OrbitView1_View.SetCurrentLocation = On;
OrbitView1_View.CurrentEye = [ 7461.323504196144 -38393.93610858089 -79905.36630754358 ];
OrbitView1_View.CurrentCenter = [ 1.818989403545856e-12 -2.91038304567337e-11 1.455191522836685e-11 ];
OrbitView1_View.CurrentUp = [ 0.341332996590487 0.8592631357666551 -0.3809969146213827 ];
OrbitView1_View.FOVy = 45;

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------
BeginMissionSequence;

% Initial Reporting
Report A3_StateHist A3_SC.ElapsedSecs A3_SC.EarthMJ2000Eq.X A3_SC.EarthMJ2000Eq.Y A3_SC.EarthMJ2000Eq.Z A3_SC.EarthMJ2000Eq.VX A3_SC.EarthMJ2000Eq.VY A3_SC.EarthMJ2000Eq.VZ;
eventCode = 1;
Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

% Propagate to start
Propagate 'Prop To Perigee' A3_Prop(A3_SC) {A3_SC.Earth.Periapsis};

% Continuous Low-Thrust Spiral to GEO
eventCode = 10;
Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;
BeginFiniteBurn A3_FB(A3_SC);
Propagate 'Spiral To GEO' A3_Prop(A3_SC) {A3_SC.Earth.SMA = 42164};
EndFiniteBurn A3_FB(A3_SC);
eventCode = 11;
Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

% Trim to target eccentricity and inclination
Propagate 'Prop To Equator' A3_Prop(A3_SC) {A3_SC.Z = 0, StopTolerance = 1e-05};
eventCode = 12;
Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

% Phase A only: converge SMA + ECC in full-force model.
% ECC=0.001 is handled in a later phase; this phase uses reachable ECC cleanup.
% Stage-1: trim ECC with radial component.
Target 'Trim ECC' A3_DC3 {SolveMode = Solve, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary A3_DC3(A3_PlaneChange.Element3 = 0, {Perturbation = 1e-03, Lower = -5.0, Upper = 5.0, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver 'ECC trim' A3_PlaneChange(A3_SC);
   Propagate 'Settle after ECC trim' A3_Prop(A3_SC) {A3_SC.ElapsedSecs = 3600};
   Achieve A3_DC3(A3_SC.Earth.ECC = geoEccPhaseA, {Tolerance = 5e-3});
EndTarget;  % For targeter A3_DC3

% Stage-2: trim SMA with tangential component.
Target 'Trim SMA' A3_DC3 {SolveMode = Solve, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary A3_DC3(A3_PlaneChange.Element1 = 0, {Perturbation = 1e-03, Lower = -5.0, Upper = 5.0, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver 'SMA trim' A3_PlaneChange(A3_SC);
   Propagate 'Settle after SMA trim' A3_Prop(A3_SC) {A3_SC.ElapsedSecs = 3600};
   Achieve A3_DC3(A3_SC.Earth.SMA = geoSmaKm, {Tolerance = 5});
EndTarget;  % For targeter A3_DC3

% Stage-3: coupled cleanup for SMA + ECC only.
Target 'Cleanup SMA/ECC' A3_DC3 {SolveMode = Solve, ExitMode = SaveAndContinue, ShowProgressWindow = true};
   Vary A3_DC3(A3_PlaneChange.Element1 = 0, {Perturbation = 5e-04, Lower = -5.0, Upper = 5.0, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Vary A3_DC3(A3_PlaneChange.Element3 = 0, {Perturbation = 5e-04, Lower = -5.0, Upper = 5.0, MaxStep = 0.5, AdditiveScaleFactor = 0.0, MultiplicativeScaleFactor = 1.0});
   Maneuver 'Cleanup trim' A3_PlaneChange(A3_SC);
   Propagate 'Settle after cleanup' A3_Prop(A3_SC) {A3_SC.ElapsedSecs = 3600};
   Achieve A3_DC3(A3_SC.Earth.SMA = geoSmaKm, {Tolerance = 3});
   Achieve A3_DC3(A3_SC.Earth.ECC = geoEccPhaseA, {Tolerance = 5e-3});
EndTarget;  % For targeter A3_DC3
eventCode = 13;
Report A3_SpiralEvents eventCode A3_SC.ElapsedSecs A3_SC.TotalMass A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC;

% Post-GEO Coasting
For i = 1:1:720;
   Propagate 'Post GEO Coast' A3_Prop(A3_SC) {A3_SC.ElapsedSecs = 60};
   Report A3_StateHist A3_SC.ElapsedSecs A3_SC.EarthMJ2000Eq.X A3_SC.EarthMJ2000Eq.Y A3_SC.EarthMJ2000Eq.Z A3_SC.EarthMJ2000Eq.VX A3_SC.EarthMJ2000Eq.VY A3_SC.EarthMJ2000Eq.VZ;
EndFor;

Report A3_FinalReport A3_SC.ElapsedSecs A3_SC.Earth.SMA A3_SC.Earth.ECC A3_SC.EarthMJ2000Eq.INC A3_SC.TotalMass;
