Create ReportFile A3_FinalReport;
A3_FinalReport.SolverIterations = Current;
A3_FinalReport.UpperLeft = [ 0.1223529411764706 0.2503008423586041 ];
A3_FinalReport.Size = [ 0.5994117647058823 0.7990373044524669 ];
A3_FinalReport.RelativeZOrder = 1553;
A3_FinalReport.Maximized = false;

A3_FinalReport.Filename = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/gmat_final.txt';
