Madrid.MinimumElevationAngle = 10;









%----------------------------------------
%---------- Force model (A-0 case 5 pattern)
%----------------------------------------
Create ForceModel A3_FM;

A3_FM.CentralBody = Earth;
A3_FM.PrimaryBodies = {Earth};
A3_FM.PointMasses = {Sun, Luna};
A3_FM.SRP = On;
A3_FM.RelativisticCorrection = Off;
A3_FM.ErrorControl = RSSStep;
A3_FM.GravityField.Earth.Degree = 20;
A3_FM.GravityField.Earth.Order = 20;
A3_FM.GravityField.Earth.StmLimit = 100;
A3_FM.GravityField.Earth.PotentialFile = 'JGM2.cof';
A3_FM.GravityField.Earth.TideModel = 'None';
A3_FM.SRP.Flux = 1367;
A3_FM.SRP.SRPModel = Spherical;
A3_FM.SRP.Nominal_Sun = 149597870.691;
A3_FM.Drag.AtmosphereModel = NRLMSISE00;
A3_FM.Drag.HistoricWeatherSource = 'CSSISpaceWeatherFile';
A3_FM.Drag.PredictedWeatherSource = 'CSSISpaceWeatherFile';
A3_FM.Drag.CSSISpaceWeatherFile = 'SpaceWeather-All-v1.2.txt';
A3_FM.Drag.SchattenFile = 'SchattenPredict.txt';
A3_FM.Drag.F107 = 150;
A3_FM.Drag.F107A = 150;
A3_FM.Drag.MagneticIndex = 3;
A3_FM.Drag.SchattenErrorModel = 'Nominal';
A3_FM.Drag.SchattenTimingModel = 'NominalCycle';
A3_FM.Drag.DragModel = 'Spherical';

%----------------------------------------
%---------- Propagator
%----------------------------------------
Create Propagator A3_Prop;

A3_Prop.FM = A3_FM;
A3_Prop.Type = RungeKutta89;
A3_Prop.InitialStepSize = 10;
A3_Prop.Accuracy = 1e-10;
A3_Prop.MinStep = 0.001;
A3_Prop.MaxStep = 2700;
A3_Prop.MaxStepAttempts = 50;
A3_Prop.StopIfAccuracyIsViolated = false;

%----------------------------------------
%---------- Burns
%----------------------------------------

Create FiniteBurn A3_FB;

A3_FB.Thrusters = {A3_Engine};
A3_FB.ThrottleLogicAlgorithm = 'MaxNumberOfThrusters';

Create ImpulsiveBurn A3_PlaneChange;

A3_PlaneChange.CoordinateSystem = Local;
A3_PlaneChange.Origin = Earth;
A3_PlaneChange.Axes = VNB;
A3_PlaneChange.Element1 = 0;
A3_PlaneChange.Element2 = 0;
A3_PlaneChange.Element3 = 0;
A3_PlaneChange.DecrementMass = false;
A3_PlaneChange.Isp = 300;
A3_PlaneChange.GravitationalAccel = 9.81;

%----------------------------------------
%---------- EventLocators
%----------------------------------------

Create ContactLocator A3_Contacts;

A3_Contacts.Target = A3_SC;
A3_Contacts.Filename = '/media/mahmedext/7616F05F16F02233/Users/mahmed.ext/Downloads/Intern_ws/catec_ws/data/benchmark_a/gmat/a3_leo_geo_transfer/madrid_contacts.txt';
A3_Contacts.InputEpochFormat = 'UTCGregorian';
A3_Contacts.InitialEpoch = '15 Jun 2026 12:00:00.000';
A3_Contacts.StepSize = 60;
A3_Contacts.FinalEpoch = '20 Jun 2026 12:00:00.000';
A3_Contacts.UseLightTimeDelay = true;
A3_Contacts.UseStellarAberration = true;
A3_Contacts.WriteReport = true;
A3_Contacts.RunMode = Automatic;
A3_Contacts.UseEntireInterval = true;
A3_Contacts.Observers = {Madrid};
A3_Contacts.LightTimeDirection = Transmit;
A3_Contacts.LeftJustified = false;
A3_Contacts.ReportPrecision = 6;
A3_Contacts.ReportFormat = 'Legacy';
A3_Contacts.IntervalStepSize = 0;
A3_Contacts.ReportTimeFormat = 'UTCGregorian';

%----------------------------------------
%---------- Solvers
%----------------------------------------
Create DifferentialCorrector A3_DC1;

A3_DC1.ShowProgress = true;
A3_DC1.ReportStyle = Normal;
A3_DC1.ReportFile = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/dc_burn1.data';
A3_DC1.MaximumIterations = 100;
A3_DC1.DerivativeMethod = ForwardDifference;
A3_DC1.Algorithm = NewtonRaphson;

Create DifferentialCorrector A3_DC2;

A3_DC2.ShowProgress = true;
A3_DC2.ReportStyle = Normal;
A3_DC2.ReportFile = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/dc_burn2.data';
A3_DC2.MaximumIterations = 50;
A3_DC2.DerivativeMethod = ForwardDifference;
A3_DC2.Algorithm = NewtonRaphson;

Create DifferentialCorrector A3_DC3;

A3_DC3.ShowProgress = true;
A3_DC3.ReportStyle = Normal;
A3_DC3.ReportFile = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/dc_burn3.data';
A3_DC3.MaximumIterations = 50;
A3_DC3.DerivativeMethod = ForwardDifference;
A3_DC3.Algorithm = NewtonRaphson;

Create DifferentialCorrector A3_DC2_5;
A3_DC2_5.ShowProgress = true;
A3_DC2_5.ReportStyle = Normal;
A3_DC2_5.ReportFile = '../../../../data/benchmark_a/gmat/a3_leo_geo_transfer/dc_burn2_5.data';
A3_DC2_5.MaximumIterations = 50;
A3_DC2_5.DerivativeMethod = ForwardDifference;
A3_DC2_5.Algorithm = NewtonRaphson;
