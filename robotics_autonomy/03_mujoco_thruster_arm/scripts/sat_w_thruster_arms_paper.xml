<mujoco>
  <!-- MuJoCo default angle unit is degree; paper joint limits are in radians. -->
  <compiler angle="radian" />
  <option gravity="0 0 0" />

  <!--
    Phase C geometry decision: PAPER-FAITHFUL FULL HUB CONTACT.
      hub_main = paper envelope 0.79 x 0.69 x 0.52 m (visual + collision).
      Not using inset/visual dual-box split.
    Boom capsules start at fromto x=0.12 so theta=0 is not already in contact
    at the mount face; FSW ALLOC_JOINT_LIMIT_RAD must stay matched to this mesh
    (see BSK_MujocoFSW_Paper.py / phaseC_geometry_audit.py).
  -->

  <worldbody>
    <body name="hub">
      <freejoint />
      <!-- Full paper hub: visual + hard-body collision boundary -->
      <geom name="hub_main" type="box" size="0.79 0.69 0.52" rgba="1 0 0 0.35"
            contype="2" conaffinity="1" mass="980" />
      <site name="hub_center" pos="0 0 0" />

      <body name="arm_1_base" pos="0.79 0 0">
        <!-- Start boom outboard of the mount face (false-contact avoidance at θ=0). -->
        <geom name="boom_1" type="capsule" size="0.1" fromto="0.12 0 0 1.0 0 0"
              rgba="1 0 0 1" contype="1" conaffinity="2" mass="8" />
        <!-- Paper joint limits: (-pi, pi] — FSW uses tighter hub-clearance cmds -->
        <joint name="arm_1_joint_1" axis="1 0 0" range="-3.14159265 3.14159265" damping="0.05" limited="true" />
        <joint name="arm_1_joint_2" axis="0 1 0" range="-3.14159265 3.14159265" damping="0.05" limited="true" />

        <body name="arm_1_tip" pos="1 0 0">
          <geom name="tip_1" type="capsule" size="0.05" fromto="0 0 0 0.1 0 0"
                rgba="1 0 0 1" contype="1" conaffinity="2" mass="2" />
          <joint name="arm_1_joint_3" axis="0 0 1" range="-3.14159265 3.14159265" damping="0.05" limited="true" />
          <joint name="arm_1_joint_4" axis="0 1 0" range="-3.14159265 3.14159265" damping="0.05" limited="true" />
          <site name="thruster_1" pos="0.1 0 0" />
        </body>
      </body>

      <body name="arm_2_base" pos="-0.79 0 0" xyaxes="-1 0 0 0 -1 0">
        <geom name="boom_2" type="capsule" size="0.1" fromto="0.12 0 0 1.0 0 0"
              rgba="1 0 0 1" contype="1" conaffinity="2" mass="8" />
        <joint name="arm_2_joint_1" axis="1 0 0" range="-3.14159265 3.14159265" damping="0.05" limited="true" />
        <joint name="arm_2_joint_2" axis="0 1 0" range="-3.14159265 3.14159265" damping="0.05" limited="true" />

        <body name="arm_2_tip" pos="1 0 0">
          <geom name="tip_2" type="capsule" size="0.05" fromto="0 0 0 0.1 0 0"
                rgba="1 0 0 1" contype="1" conaffinity="2" mass="2" />
          <joint name="arm_2_joint_3" axis="0 0 1" range="-3.14159265 3.14159265" damping="0.05" limited="true" />
          <joint name="arm_2_joint_4" axis="0 1 0" range="-3.14159265 3.14159265" damping="0.05" limited="true" />
          <site name="thruster_2" pos="0.1 0 0" />
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="F_thruster_1" site="thruster_1" gear="-1 0 0 0 0 0" forcerange="-0.25 0.25" />
    <motor name="F_thruster_2" site="thruster_2" gear="-1 0 0 0 0 0" forcerange="-0.25 0.25" />

    <motor name="u_arm_1_joint_1" joint="arm_1_joint_1" gear="1" forcerange="-2.5 2.5" />
    <motor name="u_arm_1_joint_2" joint="arm_1_joint_2" gear="1" forcerange="-2.5 2.5" />
    <motor name="u_arm_1_joint_3" joint="arm_1_joint_3" gear="1" forcerange="-2.5 2.5" />
    <motor name="u_arm_1_joint_4" joint="arm_1_joint_4" gear="1" forcerange="-2.5 2.5" />

    <motor name="u_arm_2_joint_1" joint="arm_2_joint_1" gear="1" forcerange="-2.5 2.5" />
    <motor name="u_arm_2_joint_2" joint="arm_2_joint_2" gear="1" forcerange="-2.5 2.5" />
    <motor name="u_arm_2_joint_3" joint="arm_2_joint_3" gear="1" forcerange="-2.5 2.5" />
    <motor name="u_arm_2_joint_4" joint="arm_2_joint_4" gear="1" forcerange="-2.5 2.5" />

    <motor name="tau_prescribed_1" site="hub_center" gear="0 0 0 1 0 0" forcerange="-20.0 20.0" />
    <motor name="tau_prescribed_2" site="hub_center" gear="0 0 0 0 1 0" forcerange="-20.0 20.0" />
    <motor name="tau_prescribed_3" site="hub_center" gear="0 0 0 0 0 1" forcerange="-20.0 20.0" />
  </actuator>
  <contact>
    <!-- Explicit hub↔arm pairs (paper-faithful self-collision). -->
    <pair geom1="hub_main" geom2="boom_1" />
    <pair geom1="hub_main" geom2="boom_2" />
    <pair geom1="hub_main" geom2="tip_1" />
    <pair geom1="hub_main" geom2="tip_2" />
  </contact>
</mujoco>
